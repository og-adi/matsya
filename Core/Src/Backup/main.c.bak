/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_DAC_Init();
  MX_TIM6_Init();
  MX_ADC1_Init();
  MX_TIM7_Init();
  MX_USART2_UART_Init();
  /* USER CODE BEGIN 2 */
  HAL_DBGMCU_EnableDBGSleepMode();
  HAL_DBGMCU_EnableDBGStopMode();
  HAL_DBGMCU_EnableDBGStandbyMode();
  seed_initial_waveform();

  HAL_TIM_Base_Start(&htim6);
  HAL_DAC_Start_DMA(&hdac, DAC_CHANNEL_1,
                     (uint32_t *)dac_buffer, 2 * HALF_BUF_SAMPLES,
                     DAC_ALIGN_12B_R);

  HAL_TIM_Base_Start_IT(&htim7);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */
	  __WFI();

	    if (g_print_ready) {
	        g_print_ready = 0;
	        char msg[128];
	        int len = snprintf(msg, sizeof(msg),"turb_raw=%lu depth_raw=%lu f_start=%.1f f_end=%.1f dur=%.2fms amp=%.2f\r\n",(unsigned long)g_last_turb_raw, (unsigned long)g_last_depth_raw,g_current_params.f_start_hz, g_current_params.f_end_hz,g_current_params.duration_s * 1000.0f, g_current_params.amplitude);
	        HAL_UART_Transmit(&huart2, (uint8_t *)msg, len, 100);
	    }
    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

