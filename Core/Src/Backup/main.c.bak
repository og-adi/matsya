/* USER CODE BEGIN PV */
#define HALF_BUF_SAMPLES 1024u
static uint16_t dac_buffer[2 * HALF_BUF_SAMPLES];
static volatile sonar_params_t g_current_params;
static volatile float g_sample_rate_hz = 200000.0f;   // must match your TIM6 config
static volatile uint8_t g_params_dirty = 0;
static float last_turbidity = -1.0f, last_depth = -1.0f;
static volatile uint8_t g_print_ready = 0;
static volatile uint32_t g_last_turb_raw = 0, g_last_depth_raw = 0;
#define HYSTERESIS_TURB   0.03f
#define HYSTERESIS_DEPTH  2.0f
/* USER CODE END PV */

