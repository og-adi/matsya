/* USER CODE BEGIN 4 */
static void seed_initial_waveform(void)
{
    g_current_params = sonar_adaptive_params(0.3f, 20.0f); // sane default
    sonar_fill_lfm_lut(dac_buffer, HALF_BUF_SAMPLES,
                        (sonar_params_t *)&g_current_params,
                        g_sample_rate_hz, WINDOW_HAMMING);
    sonar_fill_lfm_lut(dac_buffer + HALF_BUF_SAMPLES, HALF_BUF_SAMPLES,
                        (sonar_params_t *)&g_current_params,
                        g_sample_rate_hz, WINDOW_HAMMING);
}

static void adc_slow_task_update(float turbidity_raw, float depth_raw_m)
{
    if (fabsf(turbidity_raw - last_turbidity) < HYSTERESIS_TURB &&
        fabsf(depth_raw_m   - last_depth)     < HYSTERESIS_DEPTH) {
        return;
    }
    last_turbidity = turbidity_raw;
    last_depth     = depth_raw_m;

    sonar_params_t p = sonar_adaptive_params(turbidity_raw, depth_raw_m);
    g_current_params = p;
    g_params_dirty = 1;
}

// DMA half/full callbacks -- HAL calls these automatically once DAC DMA is running
void HAL_DAC_ConvHalfCpltCallbackCh1(DAC_HandleTypeDef *hdac)
{
    if (g_params_dirty) {
        sonar_fill_lfm_lut(dac_buffer + HALF_BUF_SAMPLES, HALF_BUF_SAMPLES,
                            (sonar_params_t *)&g_current_params,
                            g_sample_rate_hz, WINDOW_HAMMING);
    }
}

void HAL_DAC_ConvCpltCallbackCh1(DAC_HandleTypeDef *hdac)
{
	HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);

    if (g_params_dirty) {
        sonar_fill_lfm_lut(dac_buffer, HALF_BUF_SAMPLES,
                            (sonar_params_t *)&g_current_params,
                            g_sample_rate_hz, WINDOW_HAMMING);
        g_params_dirty = 0;
    }
}

// TIM7 interrupt -- fires every 50ms, kicks off a software-triggered ADC read
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM7) {
    	HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);   // visible ~10Hz blink
        HAL_ADC_Start(&hadc1);
        if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK) {
            uint32_t turb_raw  = HAL_ADC_GetValue(&hadc1);   // Rank 1
            HAL_ADC_PollForConversion(&hadc1, 10);
            uint32_t depth_raw = HAL_ADC_GetValue(&hadc1);   // Rank 2

            float turbidity = turb_raw / 4095.0f;             // -> 0..1
            float depth_m   = (depth_raw / 4095.0f) * 200.0f; // -> 0..200m

            adc_slow_task_update(turbidity, depth_m);
            g_last_turb_raw  = turb_raw;
            g_last_depth_raw = depth_raw;
            g_print_ready = 1;
        }
        HAL_ADC_Stop(&hadc1);
    }
}
/* USER CODE END 4 */

